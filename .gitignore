# ============================================================
# .gitignore para Next.js + TypeScript + Tailwind (cv-ats-optimizer)
# ============================================================

# ---- Dependencias ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js ----
/.next/
/out/
next-env.d.ts

# ---- Build / Producción ----
/build
/dist

# ---- Variables de entorno y secretos ----
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.cert

# ---- Testing / Coverage ----
/coverage
.nyc_output/

# ---- Vercel ----
.vercel

# ---- TypeScript ----
*.tsbuildinfo

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ---- macOS ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ---- Windows ----
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editores e IDEs ----
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.iws
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# ---- ESLint / Prettier ----
.eslintcache
.prettiercache

# ---- Tailwind / PostCSS ----
.stylelintcache

# ---- Turbopack / Cache ----
.turbo/
.cache/
.parcel-cache/

# ---- Misc ----
*.tmp
*.temp
*.bak
*.backup
